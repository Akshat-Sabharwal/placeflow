{
  "name": "placeflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --project=desktop --project=mobile",
    "test:e2e:authenticated": "playwright test --project=authenticated",
    "test:e2e:production": "PLAYWRIGHT_PRODUCTION=true playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:deploy": "node scripts/deploy-supabase.mjs",
    "supabase:promote": "node scripts/promote-coordinator.mjs",
    "supabase:seed-demo": "node scripts/seed-demo-data.mjs",
    "setup:check": "node scripts/verify-setup.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "3.36.1",
    "@emotion/react": "11.14.0",
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.102.2",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "sonner": "2.0.8",
    "tesseract.js": "7.0.0",
    "web-push": "3.6.7",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "27.0.1",
    "supabase": "2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
